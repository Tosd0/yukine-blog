---
import { themeConfig } from '@/theme.config'

const { author } = themeConfig.site

const year = new Date().getFullYear()

const { class: className } = Astro.props
---

<div class={className}>
  <p class="font-bold text-3">
    <span>© {year} {author}</span>
  </p>

  <p class="font-bold text-3">
    <span>Theme from </span>
    <a target="_blank" class="link" href="https://typography.moeyua.com">Typography</a>
    <span> · </span>
    <span>Powered by </span>
    <a class="link" target="_blank" href="https://astro.build/">Astro</a>
  </p>
</div>

<style></style>
