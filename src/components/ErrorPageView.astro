---
import type { ErrorPageAction } from '@/config/error-pages'
import type { SupportedLocale } from '@/i18n/locales'

interface Props {
  statusCode: string
  statusText: string
  message: string
  actions: ErrorPageAction[]
  locale?: SupportedLocale
}

const { statusCode, statusText, message, actions, locale = 'en-us' } = Astro.props
const [primaryAction, ...secondaryActions] = actions

const localeMarkMap: Record<SupportedLocale, string> = {
  'en-us': 'Error',
  'zh-cn': '错误',
  'zh-tw': '錯誤',
  'ja-jp': 'エラー',
  'ko-kr': '오류',
  'it-it': 'Errore',
}

const localeMark = localeMarkMap[locale] ?? localeMarkMap['en-us']
---

<section
  class="error-card w-full rounded-2 px-10 py-8 md:px-14 md:py-11 lg:px-18 lg:py-14 lg:-mt-10"
  data-code={statusCode}
>
  <p class="locale-mark" aria-hidden="true">{localeMark}</p>
  <p class="error-word-bg" aria-hidden="true">エラー</p>

  <div class="content-layer">
    <p class="font-serif text-16 leading-none font-bold tracking-[0.03em] sm:text-18 md:text-24 lg:text-28">
      {statusCode}
    </p>
    <h1 class="text-6 font-bold leading-tight mt-2.5 sm:text-6.5 md:text-7">{statusText}</h1>
    <p class="text-4 leading-7 mt-4.5 max-w-72 sm:text-4.25 sm:leading-8 sm:max-w-78">{message}</p>

    <div class="mt-6.5 sm:mt-8 flex flex-wrap items-center gap-2.5 sm:gap-3">
      {
        primaryAction && (
          <a href={primaryAction.href} class="link font-bold px-3 py-1.5 rounded">
            {primaryAction.label}
          </a>
        )
      }

      {
        secondaryActions.map((action) => (
          <a href={action.href} class="link px-3 py-1.5 rounded">
            {action.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style scoped>
  .error-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--colors-primary) 18%, transparent);
    background:
      radial-gradient(
        circle at 85% -5%,
        color-mix(in oklch, var(--colors-primary) 14%, transparent) 0%,
        transparent 45%
      ),
      color-mix(in oklch, var(--colors-secondary) 88%, var(--colors-primary) 2%);
  }

  .content-layer {
    position: relative;
    z-index: 1;
  }

  .locale-mark {
    position: absolute;
    inset: 1.8rem auto auto 1.7rem;
    margin: 0;
    font-size: clamp(2.3rem, 9.4vw, 4rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: color-mix(in oklch, var(--colors-primary) 58%, transparent);
    opacity: 0.22;
    filter: blur(2px);
    pointer-events: none;
    z-index: 0;
  }

  .error-card::before {
    content: attr(data-code);
    position: absolute;
    inset: auto -0.22em -0.16em auto;
    font-size: clamp(5.5rem, 20vw, 12rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: color-mix(in oklch, var(--colors-primary) 24%, transparent);
    opacity: 0.42;
    filter: blur(2.2px);
    pointer-events: none;
    z-index: 0;
  }

  .error-card::after {
    content: '雪音 · Yukine';
    position: absolute;
    inset: 1.6rem 1.45rem auto auto;
    font-size: clamp(1.25rem, 4vw, 1.8rem);
    font-family: var(--font-serif);
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: color-mix(in oklch, var(--colors-primary) 65%, transparent);
    opacity: 0.56;
    pointer-events: none;
    z-index: 0;
  }

  .error-word-bg {
    position: absolute;
    inset: auto -0.2em 8rem auto;
    margin: 0;
    font-size: clamp(2.85rem, 9.8vw, 5.7rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: color-mix(in oklch, var(--colors-primary) 24%, transparent);
    opacity: 0.42;
    filter: blur(2.2px);
    pointer-events: none;
    z-index: 0;
  }

  @media (orientation: portrait) {
    .locale-mark {
      inset: 1.25rem auto auto 0.95rem;
      font-size: clamp(1.8rem, 10vw, 2.8rem);
      filter: blur(2.2px);
      opacity: 0.2;
    }

    .error-card::before {
      inset: auto -0.18em -0.12em auto;
      font-size: clamp(4.6rem, 23vw, 8.5rem);
      opacity: 0.34;
    }

    .error-card::after {
      inset: 1.25rem 0.95rem auto auto;
      font-size: clamp(1rem, 4.2vw, 1.3rem);
      opacity: 0.5;
    }

    .error-word-bg {
      inset: auto -0.16em 5.65rem auto;
      font-size: clamp(2.15rem, 10.6vw, 4.4rem);
      opacity: 0.34;
    }
  }
</style>
