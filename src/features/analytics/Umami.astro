---
import { themeConfig } from '@/theme.config'

const scriptSrc = themeConfig.analytics.umami?.scriptUrl ?? 'https://analytics.umami.is/script.js'
const websiteId = themeConfig.analytics.umami?.websiteId?.trim()
const umamiPlaceholders = new Set(['YOUR_UMAMI_WEBSITE_ID', 'your-umami-website-id'])
const isUmamiConfigured = Boolean(websiteId && !umamiPlaceholders.has(websiteId))
---

{
  isUmamiConfigured && (
    <script type="text/partytown" is:inline async defer src={scriptSrc} data-website-id={websiteId} />
  )
}
